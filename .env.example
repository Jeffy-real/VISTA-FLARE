# Vista Flare Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME=Vista Flare
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=sqlite:///./data/vista_flare.db

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# External APIs (Optional - for live job data)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ARBEITNOW_API_KEY=
REMOTIVE_API_KEY=

# Model
MODEL_VERSION=ann-v1
DEFAULT_MODEL=ann
