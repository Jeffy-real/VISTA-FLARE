# Vista Flare — local development environment

# Application
APP_NAME=Vista Flare
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=sqlite:///./data/vista_flare.db

# Security — replace the placeholder with a securely generated random value
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
SECURE_COOKIES=false
SESSION_MAX_AGE=2592000
CORS_ORIGINS=["http://localhost:5173"]

# Job ingestion
INGESTION_ADMIN_SECRET=REPLACE_WITH_A_SEPARATE_RANDOM_SECRET
INGESTION_STALE_AFTER_HOURS=48
ENABLE_INGESTION_SCHEDULER=false
INGESTION_INTERVAL_MINUTES=360

# External job APIs (backend server-side only)
# Arbeitnow and Remotive use documented public endpoints and require no API keys.
# Adzuna requires registered credentials from https://developer.adzuna.com:
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb
ADZUNA_QUERY=

# Model
MODEL_VERSION=ann-v1
DEFAULT_MODEL=ann
